# Modèle de configuration : copier en .env (cp .env.example .env) puis
# remplacer les valeurs « à-changer ». Ne jamais versionner le .env.
# Les valeurs ci-dessous correspondent à la stack Docker locale
# (docker compose up -d --build) ; en production, docker-compose.yml
# prend par défaut les URL senlab.site.

# --- Django ---
SECRET_KEY=à-changer-chaine-aleatoire-longue
DEBUG=False
# Écrasé par docker-compose (conteneur « db ») ; utile hors Docker.
DATABASE_URL=postgresql://senlab:à-changer@localhost:5432/senlab
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:8090

# --- E-mails ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=à-changer
EMAIL_HOST_PASSWORD=à-changer
DEFAULT_FROM_EMAIL=SenLab <no-reply@example.com>

# Base des liens envoyés par e-mail (activation, mot de passe...).
# Docker local : le frontend est servi sur le port 8090 (et non 4200,
# qui est le port de « ng serve »).
FRONTEND_URL=http://localhost:8090

# --- Services ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/senlab
IA_SERVICE_URL=http://localhost:8011/api
TACHES_TOKEN=à-changer-jeton-des-taches-planifiees

# --- PostgreSQL (conteneur « db ») ---
POSTGRES_DB=senlab
POSTGRES_USER=senlab
POSTGRES_PASSWORD=à-changer

# --- URL publiques lues par docker-compose.yml ---
PORT_HTTP=8090
URL_PUBLIQUE=http://localhost:8090
# Liens des e-mails : doit être l'adresse du frontend Docker.
URL_FRONTEND=http://localhost:8090
URL_API=http://localhost:8010
URL_IA=http://localhost:8011
ORIGINES_FRONTEND=http://localhost:4200,http://localhost:8090
ORIGINES_FRONTEND_IA=["http://localhost:4200","http://localhost:8090"]
# False en local (HTTP) ; True en production (HTTPS).
COOKIES_SECURISES=False

# --- Service IA ---
MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
HUGGINGFACE_API_KEY=
